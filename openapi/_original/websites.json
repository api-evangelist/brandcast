                ]
            }]
        },
        {
            "path": "/websites/{websiteId}/medialibrary",
            "operations": [{
                "method": "POST",
                "summary": "Add to website media library",
                "notes": "Supported media are video/youtube and video/vimeo. Subsequently, once the media has been added to S3, the media ID can be used to update content in the website.",
                "nickname": "addToWebsiteMediaLibrary",
                "parameters": [
                    {
                        "name": "x-api-key",
                        "description": "API key",
                        "required": true,

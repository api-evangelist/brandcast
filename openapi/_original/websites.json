                    },
                    {
                        "name": "website",
                        "description": "JSON body",
                        "required": true,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "body"
                    }
                ]
            }]
        },
        {
            "path": "/websites/{websiteId}",

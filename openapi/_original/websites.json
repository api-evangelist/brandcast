                    {
                        "name": "websiteId",
                        "description": "Website ID",
                        "required": true,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "path"
                    },
                    {
                        "name": "body",
                        "description": "Custom Vars",
                        "required": false,
                        "paramType": "body",
                        "dataType": "CustomVars"
                    }

{
    "apiVersion": "1.0.0",
    "swaggerVersion": "1.2",
    "basePath": "https://api.brandcast-prod.io/v1",
    "produces": ["application/json"],
    "apis": [
        {
            "path": "/websites",
            "operations": [{
                "method": "GET",
                "summary": "Get websites",
                "notes": "Returns websites for this Brandcast account.",
                "nickname": "getWebsites",
                "parameters": [{
                    "name": "x-api-key",
                    "description": "API key",
                    "required": true,
                    "allowMultiple": false,
                    "dataType": "string",
                    "paramType": "header"
                }]
            }]
        },
        {
            "path": "/websites",
            "operations": [{
                "method": "POST",
                "summary": "Create website from template",
                "notes": "Creates website from specified template and returns data for the newly created website. However, the website won't be available on the Internet until it's explicitly <b>published<\/b>.",
                "nickname": "createWebsite",
                "parameters": [
                    {
                        "name": "x-api-key",
                        "description": "API key",
                        "required": true,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "header"
                    },
                    {
                        "name": "templateId",
                        "description": "Template ID",
                        "required": true,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "query"
                    },
                    {
                        "name": "name",
                        "description": "Name of new website",
                        "required": true,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "query"
                    },
                    {
                        "name": "subdomain",
                        "description": "Subdomain for new website",
                        "required": true,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "query"
                    },
                    {
                        "name": "newId",
                        "description": "Optional new website ID",
                        "required": false,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "query"
                    },
                    {
                        "name": "description",
                        "description": "Optional description for new website",
                        "required": false,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "query"
                    }
                ]
            }]
        },        
        {
            "path": "/websites/{websiteId}",
            "operations": [{
                "method": "GET",
                "summary": "Get website",
                "notes": "Returns data for specified website.",
                "nickname": "getWebsite",
                "parameters": [
                    {
                        "name": "x-api-key",
                        "description": "API key",
                        "required": true,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "header"
                    },
                    {
                        "name": "websiteId",
                        "description": "Website ID",
                        "required": true,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "path"
                    }
                ]
            }]
        },
        {

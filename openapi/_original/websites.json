                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "query"
                    },
                    {
                        "name": "filterLockedContent",
                        "description": "Enables/Disables the Locked Content Filter.  Defaults to <b>true<\/b>.",
                        "required": false,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "query"
                    },
                    {
                        "name": "limit",
                        "description": "Limits the size of the result set.",
                        "required": false,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "query"
                    },
                    {
                        "name": "offset",
                        "description": "If the response value next-offset exists, provide the value here to get the next page of results.",
                        "required": false,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "query"
                    }
                ]
            }]
        },
        {

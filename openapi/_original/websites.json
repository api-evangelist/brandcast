                        "required": true,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "header"
                    },
                    {
                        "name": "x-account-id",
                        "description": "The account context for this action. Required when using Authorization header.",
                        "required": false,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "header"
                    },
                    {
                        "name": "Authorization",
                        "description": "A valid JWT. Only required when called by Design Studio.",
                        "required": false,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "header"
                    },
                    {
                        "name": "websiteId",

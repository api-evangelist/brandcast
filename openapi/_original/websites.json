            "operations": [{
                "method": "POST",
                "summary": "Publish website",
                "notes": "Publishing puts the website on the Internet. This API creates a job that initiates and monitors the publishing process. Returns information about publishing the website, e.g., publishId, publishing status, etc. Then the website's publishing status can be polled via the publishId that's returned.",

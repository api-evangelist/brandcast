                        "required": true,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "path"
                    },
                    {
                        "name": "fileName",
                        "description": "The preferred name for the ZIP file.",
                        "required": true,
                        "allowMultiple": false,
                        "dataType": "string",
                        "paramType": "query"
                    }
                ]
            }]
        },
